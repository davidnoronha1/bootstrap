# ~/.config/bootstrap/bashrc - managed by bootstrap.sh, sourced from ~/.bashrc.
# Re-running bootstrap.sh overwrites this file; put personal changes in ~/.bashrc.
# Every tool below is set up only if it is installed, so this is safe on any
# machine and picks up tools installed later without being regenerated.

_bs_have() { command -v "$1" >/dev/null 2>&1; }
_bs_path_prepend() { # only existing dirs, never twice
    [ -d "$1" ] || return 0
    case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac
}

# PATH: user-level install locations (the last one listed ends up first)
# (includes tools installed before bootstrap.sh by other means)
for _bs_dir in /snap/bin /usr/local/go/bin "$HOME/go/bin" "$HOME/.dotnet/tools" "$HOME/.dotnet" \
    "$HOME/.npm-global/bin" "$HOME/.yarn/bin" "$HOME/.local/share/pnpm" "$HOME/.volta/bin" \
    "$HOME/.deno/bin" "$HOME/.opencode/bin" "$HOME/.bun/bin" "$HOME/.cargo/bin" "$HOME/.local/bin"; do
    _bs_path_prepend "$_bs_dir"
done
unset _bs_dir
export PATH
[ -d "$HOME/.bun" ] && export BUN_INSTALL="$HOME/.bun"
[ -x "$HOME/.dotnet/dotnet" ] && export DOTNET_ROOT="$HOME/.dotnet"

# Homebrew on Linux, pnpm, pyenv: set up only if present
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
[ -d "$HOME/.local/share/pnpm" ] && export PNPM_HOME="$HOME/.local/share/pnpm"
if [ -d "$HOME/.pyenv" ]; then
    export PYENV_ROOT="$HOME/.pyenv"
    _bs_path_prepend "$PYENV_ROOT/bin"
    _bs_have pyenv && eval "$(pyenv init - bash)"
fi

# nvm (node), when installed per-user
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# editor: best one available
for _bs_ed in nvim vim vi nano; do
    if _bs_have "$_bs_ed"; then export EDITOR="$_bs_ed" VISUAL="$_bs_ed"; break; fi
done
unset _bs_ed

# Everything below only matters for interactive shells.
case $- in *i*) ;; *) return 0 ;; esac

# history
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth
shopt -s histappend

# zoxide (z / zi)
_bs_have zoxide && eval "$(zoxide init bash)"

# fzf: built-in integration (fzf >= 0.48), else the files distros ship
if _bs_have fzf; then
    if ! eval "$(fzf --bash 2>/dev/null)" 2>/dev/null || ! declare -F __fzf_select__ >/dev/null; then
        for _bs_f in /usr/share/doc/fzf/examples/key-bindings.bash /usr/share/fzf/key-bindings.bash \
            /usr/share/fzf/shell/key-bindings.bash "$HOME/.fzf.bash"; do
            [ -f "$_bs_f" ] && { . "$_bs_f"; break; }
        done
        unset _bs_f
    fi
    if _bs_have fd; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    elif _bs_have fdfind; then
        export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git'
    fi
    [ -n "${FZF_DEFAULT_COMMAND:-}" ] && export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# completions for CLIs that generate their own
_bs_have gh && eval "$(gh completion -s bash 2>/dev/null)"
_bs_have uv && eval "$(uv generate-shell-completion bash 2>/dev/null)"

# aliases
if _bs_have eza; then
    alias ls='eza --group-directories-first'
    alias ll='eza -alF --group-directories-first --git'
    alias la='eza -a --group-directories-first'
    alias l='eza -F'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias mv='mv -v'
alias cp='cp -v'
alias killall='pkill'
_bs_have gdb && alias gdb='gdb -q '
_bs_have wget && alias wget='wget --hsts-file /dev/null -c'
# Debian/Ubuntu install these under other names
! _bs_have fd && _bs_have fdfind && alias fd='fdfind'
if _bs_have bat; then
    alias cat='bat'
elif _bs_have batcat; then
    alias bat='batcat'
    alias cat='batcat'
fi
_bs_have nvim && alias vim='nvim'
if _bs_have git; then
    alias g='git'
    alias ga='git add'
    alias gc='git commit -m'
    alias gs='git status'
    alias gp='git push'
    alias gl='git log --oneline --graph --decorate --all -20'
    alias gitFixup='git commit --fixup=HEAD'
    alias gitShallowClone='git clone --depth 1'
    alias gitS='git status --short'
fi
if _bs_have docker; then
    alias dc='docker compose'
    alias dcu='docker compose up -d'
    alias dcd='docker compose down'
fi
