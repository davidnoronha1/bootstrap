/* Dark #121214 / surface #1a1a1e / border #2a2a30, text #f4f4f5 / muted #a1a1aa, accent #e11d48 */

Screen {
    background: #121214;
    color: #f4f4f5;
}

#main {
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

#btn-record {
    width: 100%;
    max-width: 72;
    height: 9;
    background: #e11d48;
    color: #ffffff;
    border: none;
    text-style: bold;
    content-align: center middle;
}

#btn-record:hover {
    background: #be123c;
}

#btn-record:focus {
    text-style: bold reverse;
}

#btn-record.recording {
    background: #1a1a1e;
    color: #e11d48;
    border: heavy #e11d48;
}

#targets {
    width: 100%;
    max-width: 72;
    height: 3;
    margin-top: 1;
}

.target {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
    background: #1a1a1e;
    color: #a1a1aa;
    border: none;
    text-style: bold;
}

.target:last-of-type {
    margin: 0;
}

.target:hover, .target:focus {
    color: #f4f4f5;
    background: #2a2a30;
}

.target.active {
    background: #f4f4f5;
    color: #121214;
}

#target-info {
    width: 100%;
    max-width: 72;
    margin-top: 1;
    content-align: center middle;
    text-align: center;
    color: #f4f4f5;
}

#links {
    width: 100%;
    max-width: 72;
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

.link {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 2;
    padding: 0 1;
    border: none;
    background: #121214;
    color: #a1a1aa;
}

.link:hover, .link:focus {
    color: #f4f4f5;
    text-style: underline;
}

/* Advanced screen */

#adv-title {
    height: 1;
    margin: 1 2 0 2;
    color: #e11d48;
    text-style: bold;
}

#adv-body {
    padding: 1 2;
}

#adv-grid {
    grid-size: 2;
    grid-columns: 20 1fr;
    grid-gutter: 1 2;
    height: auto;
    max-width: 90;
}

#adv-grid > Label {
    height: 3;
    content-align: left middle;
    color: #a1a1aa;
}

#adv-actions {
    height: 3;
    margin-top: 1;
}

#adv-actions Button {
    margin-right: 1;
}

/* Status bar (last row above the footer) */

#statusbar {
    height: 1;
    width: 100%;
    padding: 0 1;
    background: #1a1a1e;
    color: #a1a1aa;
}

#statusbar.recording {
    background: #e11d48;
    color: #ffffff;
}

#statusbar.error {
    background: #2a2a30;
    color: #e11d48;
}
