#!/usr/bin/env bash
# Launcher for rec. Resolves symlinks (e.g. ~/.local/bin/rec) and prefers the
# bundled venv that bootstrap.sh creates, falling back to the system python.
DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
PY="$DIR/.venv/bin/python3"
[[ -x "$PY" ]] || PY=python3
exec "$PY" "$DIR/main.py" "$@"
